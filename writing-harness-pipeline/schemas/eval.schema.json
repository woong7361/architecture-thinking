{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline Eval",
  "type": "object",
  "required": ["brief_hash", "iteration", "rubric_name", "rubric_scores", "axis_rationales", "evaluated_at", "model", "metadata"],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$"
    },
    "iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "rubric_name": {
      "type": "string",
      "minLength": 1
    },
    "rubric_scores": {
      "type": "object",
      "required": ["scores", "weights", "weighted_total"],
      "properties": {
        "scores": {
          "type": "object",
          "required": ["structure", "evidence", "sentence", "originality", "purpose_fit"],
          "properties": {
            "structure": { "type": "number", "minimum": 0, "maximum": 5 },
            "evidence": { "type": "number", "minimum": 0, "maximum": 5 },
            "sentence": { "type": "number", "minimum": 0, "maximum": 5 },
            "originality": { "type": "number", "minimum": 0, "maximum": 5 },
            "purpose_fit": { "type": "number", "minimum": 0, "maximum": 5 }
          },
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "required": ["structure", "evidence", "sentence", "originality", "purpose_fit"],
          "properties": {
            "structure": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "sentence": { "type": "number", "minimum": 0, "maximum": 1 },
            "originality": { "type": "number", "minimum": 0, "maximum": 1 },
            "purpose_fit": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "weighted_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "axis_rationales": {
      "type": "object",
      "required": ["structure", "evidence", "sentence", "originality", "purpose_fit"],
      "properties": {
        "structure": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "sentence": { "type": "string", "minLength": 1 },
        "originality": { "type": "string", "minLength": 1 },
        "purpose_fit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "calibration_note": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "prompt_version": {
          "type": "string"
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token_usage": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
