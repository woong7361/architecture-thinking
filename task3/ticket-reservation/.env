# 로컬/재현 환경 기본값. `docker compose up` 이 자동으로 읽는다.
# (walking skeleton 개발용 값이며 실제 비밀이 아니다 — 운영 비밀은 커밋하지 말 것.)

# 앱 노출 포트(호스트)
APP_PORT=8080

# MySQL 접속 정보 (앱은 이 값을 환경변수로 주입받아 연결한다)
DB_NAME=ticket
DB_USERNAME=ticket
DB_PASSWORD=ticket
MYSQL_ROOT_PASSWORD=root

# 호스트에서 MySQL 에 직접 붙을 때 쓸 포트 (앱-DB 내부 통신은 항상 컨테이너 3306)
DB_PORT=3306
