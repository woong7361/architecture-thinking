{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eval Output",
  "description": "축 이름은 rubric이 정한다. runner가 축 집합 일치·weighted_total·threshold를 결정적으로 검증.",
  "type": "object",
  "required": ["scores", "rationales"],
  "properties": {
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 5 }
    },
    "rationales": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
