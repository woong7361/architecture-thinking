{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logic-output.schema.json",
  "title": "Senior logic reviewer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer", "overall_summary", "findings", "senior_questions", "top_actions", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewer": {"const": "senior_logic_reviewer"},
    "overall_summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
    "senior_questions": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/question"}},
    "top_actions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_ids", "quote"],
      "properties": {
        "token_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^t[0-9]{4,}$"}},
        "quote": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "status", "evidence", "observation", "inference", "missing_evidence", "diagnosis", "action"],
      "properties": {
        "criterion": {"type": "string", "minLength": 1},
        "status": {"enum": ["good", "caution", "problem", "not_evaluable"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "observation": {"type": "string"},
        "inference": {"type": "string"},
        "missing_evidence": {"type": "string"},
        "diagnosis": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "why", "evidence"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
