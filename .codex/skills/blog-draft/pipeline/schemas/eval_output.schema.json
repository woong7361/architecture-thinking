{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluator Direct Output",
  "type": "object",
  "required": [
    "brief_hash",
    "iteration",
    "rubric_name",
    "rubric_scores",
    "axis_rationales",
    "calibration_note"
  ],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$"
    },
    "iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "rubric_name": {
      "type": "string",
      "minLength": 1
    },
    "rubric_scores": {
      "type": "object",
      "required": [
        "scores",
        "weights",
        "weighted_total"
      ],
      "properties": {
        "scores": {
          "type": "object",
          "required": [
            "judgment",
            "evidence",
            "reader_fit",
            "grounding",
            "structure",
            "sentence",
            "originality",
            "purpose_fit"
          ],
          "properties": {
            "judgment": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "evidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "reader_fit": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "grounding": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "structure": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "sentence": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "originality": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "purpose_fit": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "required": [
            "judgment",
            "evidence",
            "reader_fit",
            "grounding",
            "structure",
            "sentence",
            "originality",
            "purpose_fit"
          ],
          "properties": {
            "judgment": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reader_fit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grounding": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "structure": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sentence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "originality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "purpose_fit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "weighted_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "axis_rationales": {
      "type": "object",
      "required": [
        "judgment",
        "evidence",
        "reader_fit",
        "grounding",
        "structure",
        "sentence",
        "originality",
        "purpose_fit"
      ],
      "properties": {
        "judgment": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "reader_fit": {
          "type": "string",
          "minLength": 1
        },
        "grounding": {
          "type": "string",
          "minLength": 1
        },
        "structure": {
          "type": "string",
          "minLength": 1
        },
        "sentence": {
          "type": "string",
          "minLength": 1
        },
        "originality": {
          "type": "string",
          "minLength": 1
        },
        "purpose_fit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "calibration_note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
