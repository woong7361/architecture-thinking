{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposer Direct Output",
  "description": "propose gen과 propose refine이 공유하는 직접 출력. runner가 analysis_id/iteration/metadata를 감싸 proposal artifact를 만든다.",
  "type": "object",
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 1,
      "description": "시스템 수정 제안 목록. 각 제안은 독립적으로 검증·채점된다.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_file",
          "target_kind",
          "diagnosis",
          "cited_signals",
          "target_axis",
          "effect_path",
          "alternatives_considered",
          "side_effects",
          "diff",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]+$",
            "description": "제안 식별자 (예: P1)."
          },
          "target_file": {
            "type": "string",
            "minLength": 1,
            "description": "수정 대상 파일 경로."
          },
          "target_kind": {
            "type": "string",
            "enum": ["rubric", "prompt", "pipeline_code", "agents_md"],
            "description": "대상 종류. pipeline_code/agents_md는 위험이 반드시 높음이어야 한다."
          },
          "diagnosis": {
            "type": "string",
            "minLength": 1,
            "description": "어느 단계·규칙이 원인이고 왜 그런지. 메커니즘 문장 1개 이상."
          },
          "cited_signals": {
            "type": "array",
            "minItems": 1,
            "description": "진단 근거가 된 analysis.json signals[].id. 실재하는 id만.",
            "items": { "type": "string", "pattern": "^S[0-9]+$" }
          },
          "target_axis": {
            "type": "string",
            "minLength": 1,
            "description": "이 변경이 올리려는 글 평가 axis."
          },
          "effect_path": {
            "type": "string",
            "minLength": 1,
            "description": "변경 → 글 산출 변화 → axis 개선까지의 경로."
          },
          "alternatives_considered": {
            "type": "array",
            "description": "검토하고 배제한 경쟁 원인들.",
            "items": {
              "type": "object",
              "required": ["cause", "why_not"],
              "properties": {
                "cause": { "type": "string", "minLength": 1 },
                "why_not": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "side_effects": {
            "type": "string",
            "description": "이 변경이 다른 axis나 단계에 줄 수 있는 부작용."
          },
          "diff": {
            "type": "object",
            "required": ["anchor", "change"],
            "properties": {
              "anchor": {
                "type": "string",
                "minLength": 1,
                "description": "대상 파일에 실제로 존재하는 텍스트. validator가 존재를 검사한다."
              },
              "change": {
                "type": "string",
                "minLength": 1,
                "description": "추가·삭제·교체 내용."
              }
            },
            "additionalProperties": false
          },
          "risk": {
            "type": "string",
            "enum": ["낮음", "중", "높음"]
          }
        },
        "additionalProperties": false
      }
    },
    "priority_order": {
      "type": "array",
      "description": "제안이 여럿일 때 적용 순서와 근거. 제안이 1개면 생략한다.",
      "items": {
        "type": "object",
        "required": ["proposal_id", "rank", "rationale"],
        "properties": {
          "proposal_id": { "type": "string", "pattern": "^P[0-9]+$" },
          "rank": { "type": "integer", "minimum": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
