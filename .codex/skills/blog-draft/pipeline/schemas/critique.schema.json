{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline Critique",
  "type": "object",
  "required": [
    "brief_hash",
    "iteration",
    "summary",
    "strengths",
    "weaknesses",
    "revision_directions",
    "reader_risks",
    "section_reviews",
    "critiqued_at",
    "model",
    "metadata",
    "unsupported_claims",
    "suggestions"
  ],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$",
      "description": "Brief identifier for the draft being critiqued."
    },
    "iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "description": "Iteration number for the draft being critiqued."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short editorial summary of the current draft."
    },
    "strengths": {
      "type": "array",
      "description": "Strengths that should be preserved in the next draft.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weaknesses": {
      "type": "array",
      "description": "Issues that should be addressed by the next revision.",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "why_it_matters",
          "suggestion",
          "severity"
        ],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "revision_directions": {
      "type": "array",
      "description": "Concrete directions for the next revision.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reader_risks": {
      "type": "array",
      "description": "Likely reader confusion, fatigue, or misunderstanding risks.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "section_reviews": {
      "type": "array",
      "description": "section_plan이 있을 때 절별 계약 준수 결과. section_plan이 없으면 빈 배열",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "actual_heading",
          "heading_match",
          "purpose_match",
          "material_use_match",
          "out_of_scope_excerpts",
          "connection_match"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "actual_heading": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "대응하는 실제 H2. 절이 없으면 null"
          },
          "heading_match": {
            "type": "boolean"
          },
          "purpose_match": {
            "type": "boolean"
          },
          "material_use_match": {
            "type": "boolean"
          },
          "out_of_scope_excerpts": {
            "type": "array",
            "description": "소제목의 약속, 절의 목적 또는 지정 재료 범위를 벗어난 초안의 실제 문구",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "connection_match": {
            "type": "string",
            "enum": [
              "not_declared",
              "matched",
              "missed"
            ],
            "description": "connection_to_next가 없으면 not_declared. 있는 경우에만 준수 여부를 판단"
          }
        },
        "additionalProperties": false
      }
    },
    "critiqued_at": {
      "type": "string",
      "format": "date-time",
      "description": "Critique artifact creation time."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model or execution profile that produced the critique."
    },
    "metadata": {
      "type": "object",
      "description": "Reproducibility metadata controlled by the runner.",
      "properties": {
        "prompt_version": {
          "type": "string",
          "description": "Critique prompt version used by the stage."
        },
        "source_files": {
          "type": "array",
          "description": "Input files passed to the critique stage.",
          "items": {
            "type": "string"
          }
        },
        "token_usage": {
          "type": "object",
          "description": "Token usage for cost and quality comparisons.",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "unsupported_claims": {
      "type": "array",
      "description": "Statements the draft presents as fact but that cannot be traced to the brief. Empty when everything is grounded.",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "why_unsupported"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "description": "The sentence or phrase as it appears in the draft."
          },
          "why_unsupported": {
            "type": "string",
            "minLength": 1,
            "description": "What was looked for in the brief and not found."
          }
        },
        "additionalProperties": false
      }
    },
    "suggestions": {
      "type": "array",
      "description": "저자가 쓴 메시지에 없거나 반대되는 것 중 저자가 채택 여부를 정해야 하는 것. 본문에 넣지 않는다.",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target",
          "proposal",
          "needs_author"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "counterpoint",
              "angle",
              "extension",
              "reference",
              "material"
            ],
            "description": "counterpoint 반대 논리 / angle 다루지 않은 관점 / extension 더 밀고 갈 지점 / reference 외부 근거 후보 / material 저자만 댈 수 있는 재료"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "제안이 겨냥하는 초안의 대목. 해당 문장을 그대로 옮긴다"
          },
          "proposal": {
            "type": "string",
            "minLength": 1,
            "description": "제안 내용. material과 reference는 무엇이 필요한지까지만 쓰고 지어내지 않는다"
          },
          "needs_author": {
            "type": "boolean",
            "description": "저자만 댈 수 있는 것(겪은 일, 수치, 실제 출처)이면 true. AI가 만들어 낸 주장이나 관점이면 false"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
