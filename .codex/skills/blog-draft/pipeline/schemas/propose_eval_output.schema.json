{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal Evaluator Direct Output",
  "description": "propose eval의 직접 출력. proposal:v1 rubric으로 각 제안을 따로 채점한다.",
  "type": "object",
  "required": ["analysis_id", "iteration", "rubric_name", "evaluations"],
  "properties": {
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "rubric_name": {
      "type": "string",
      "minLength": 1,
      "description": "사용한 제안 rubric 이름 (예: proposal:v1)."
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "description": "제안별 채점 결과.",
      "items": {
        "type": "object",
        "required": ["proposal_id", "rubric_scores", "axis_rationales"],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "rubric_scores": {
            "type": "object",
            "required": ["scores", "weights", "weighted_total"],
            "properties": {
              "scores": {
                "type": "object",
                "required": [
                  "diagnosis_specificity",
                  "effect_plausibility",
                  "alternative_elimination",
                  "side_effect_awareness",
                  "priority_justification"
                ],
                "properties": {
                  "diagnosis_specificity": { "type": "number", "minimum": 0, "maximum": 5 },
                  "effect_plausibility": { "type": "number", "minimum": 0, "maximum": 5 },
                  "alternative_elimination": { "type": "number", "minimum": 0, "maximum": 5 },
                  "side_effect_awareness": { "type": "number", "minimum": 0, "maximum": 5 },
                  "priority_justification": { "type": "number", "minimum": 0, "maximum": 5 }
                },
                "additionalProperties": false
              },
              "weights": {
                "type": "object",
                "required": [
                  "diagnosis_specificity",
                  "effect_plausibility",
                  "alternative_elimination",
                  "side_effect_awareness",
                  "priority_justification"
                ],
                "properties": {
                  "diagnosis_specificity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "effect_plausibility": { "type": "number", "minimum": 0, "maximum": 1 },
                  "alternative_elimination": { "type": "number", "minimum": 0, "maximum": 1 },
                  "side_effect_awareness": { "type": "number", "minimum": 0, "maximum": 1 },
                  "priority_justification": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              },
              "weighted_total": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            },
            "additionalProperties": false
          },
          "axis_rationales": {
            "type": "object",
            "required": [
              "diagnosis_specificity",
              "effect_plausibility",
              "alternative_elimination",
              "side_effect_awareness",
              "priority_justification"
            ],
            "properties": {
              "diagnosis_specificity": { "type": "string", "minLength": 1 },
              "effect_plausibility": { "type": "string", "minLength": 1 },
              "alternative_elimination": { "type": "string", "minLength": 1 },
              "side_effect_awareness": { "type": "string", "minLength": 1 },
              "priority_justification": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "calibration_note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
