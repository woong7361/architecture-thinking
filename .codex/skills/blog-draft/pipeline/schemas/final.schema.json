{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline Final",
  "type": "object",
  "required": [
    "brief_hash",
    "final_iteration",
    "content",
    "accepted_at",
    "quality_snapshot",
    "contract_result",
    "lineage"
  ],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$"
    },
    "final_iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_snapshot": {
      "type": "object",
      "required": [
        "rubric_name",
        "weighted_total",
        "scores",
        "weak_axes"
      ],
      "properties": {
        "rubric_name": {
          "type": "string",
          "minLength": 1
        },
        "weighted_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          }
        },
        "weak_axes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "contract_result": {
      "type": "object",
      "required": [
        "verdict",
        "contract_errors",
        "checked_rules"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "PASS"
          ]
        },
        "contract_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": [
        "run_id",
        "input",
        "draft",
        "critique",
        "eval"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "draft": {
          "type": "string",
          "minLength": 1
        },
        "critique": {
          "type": "string",
          "minLength": 1
        },
        "eval": {
          "type": "string",
          "minLength": 1
        },
        "refine_request": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "suggestions": {
      "type": "array",
      "description": "저자가 쓴 메시지에 없거나 반대되는 것 중 저자가 채택 여부를 정해야 하는 것. 본문에 넣지 않는다.",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target",
          "proposal",
          "needs_author"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "counterpoint",
              "angle",
              "extension",
              "reference",
              "material"
            ],
            "description": "counterpoint 반대 논리 / angle 다루지 않은 관점 / extension 더 밀고 갈 지점 / reference 외부 근거 후보 / material 저자만 댈 수 있는 재료"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "제안이 겨냥하는 초안의 대목. 해당 문장을 그대로 옮긴다"
          },
          "proposal": {
            "type": "string",
            "minLength": 1,
            "description": "제안 내용. material과 reference는 무엇이 필요한지까지만 쓰고 지어내지 않는다"
          },
          "needs_author": {
            "type": "boolean",
            "description": "저자만 댈 수 있는 것(겪은 일, 수치, 실제 출처)이면 true. AI가 만들어 낸 주장이나 관점이면 false"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
