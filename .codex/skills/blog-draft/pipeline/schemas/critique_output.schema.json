{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critique Direct Output",
  "type": "object",
  "required": [
    "brief_hash",
    "iteration",
    "summary",
    "strengths",
    "weaknesses",
    "revision_directions",
    "reader_risks"
  ],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$",
      "description": "Brief identifier for the draft being critiqued."
    },
    "iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "description": "Iteration number for the draft being critiqued."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short editorial summary of the current draft."
    },
    "strengths": {
      "type": "array",
      "description": "Strengths that should be preserved in the next draft.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "weaknesses": {
      "type": "array",
      "description": "Issues that should be addressed by the next revision.",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "why_it_matters",
          "suggestion",
          "severity"
        ],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "revision_directions": {
      "type": "array",
      "description": "Concrete directions for the next revision.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reader_risks": {
      "type": "array",
      "description": "Likely reader confusion, fatigue, or misunderstanding risks.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
