{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline Draft",
  "description": "runner가 gen/refine 산출에 계보를 붙여 만든 초안. 파일 내용은 담지 않는다 — 색인과 계약 판본 포인터와 판단 기록만 담고 실물은 iter_00N/files/ 에 있다.",
  "type": "object",
  "required": [
    "brief_hash",
    "iteration",
    "stage",
    "files",
    "contract_version",
    "claims",
    "decisions",
    "contract_changes",
    "generated_at",
    "model"
  ],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$"
    },
    "iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "gen",
        "refine"
      ],
      "description": "생성 주체. 최초 생성은 gen, 반영 생성은 refine."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "이번 iteration에 쓰거나 고친 파일의 색인. 내용은 응답이 아니라 작업 폴더(runs/<run_id>/output/)에 있다. 건드리지 않은 파일은 적지 않아도 작업 폴더에 그대로 남아 이어진다. 예외는 계약 판본이다 — 고치지 않은 iteration에도 적는다. contract_version.path가 판정에 쓰이는 포인터이므로 그것이 색인 밖을 가리키면 어느 파일이 이 초안의 계약인지 말하는 자리가 빈다.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "code",
              "contract"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "contract_version": {
      "type": "object",
      "required": [
        "path",
        "from"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contract_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ignored_suggestions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "prompt_version": {
          "type": "string"
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token_usage": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "commit": {
      "type": "string",
      "description": "이 iteration을 담은 작업 폴더의 커밋 해시. 커밋은 runner가 남긴다 — 생성기는 git을 만지지 않는다."
    }
  },
  "additionalProperties": false
}
