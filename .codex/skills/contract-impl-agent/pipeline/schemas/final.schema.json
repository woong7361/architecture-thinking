{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline Final",
  "description": "PASS한 iteration의 산출. 게이트 통과와 루브릭 하한 통과가 함께 성립할 때만 나온다. decision_risk는 게이트가 아니라 통과한 run이 어떤 판단 위에 서 있는지를 드러내는 표시다.",
  "type": "object",
  "required": [
    "brief_hash",
    "final_iteration",
    "files",
    "contract_version",
    "decisions",
    "contract_changes",
    "decision_risk",
    "accepted_at",
    "quality_snapshot",
    "gate_result",
    "contract_result",
    "lineage"
  ],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$"
    },
    "final_iteration": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "PASS한 iteration의 파일 색인. 실물은 artifact/ 로 승격된다.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "code",
              "contract"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "contract_version": {
      "type": "object",
      "required": [
        "path",
        "from"
      ],
      "description": "이 run이 내놓는 계약 판본. 다음 run의 기준선이 된다.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contract_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision_risk": {
      "type": "object",
      "required": [
        "level",
        "reasons"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_snapshot": {
      "type": "object",
      "required": [
        "rubric_name",
        "weighted_total",
        "scores",
        "weak_axes"
      ],
      "properties": {
        "rubric_name": {
          "type": "string",
          "minLength": 1
        },
        "weighted_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          }
        },
        "weak_axes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "gate_result": {
      "type": "object",
      "required": [
        "g0",
        "g1",
        "changes",
        "allow_missing_gates",
        "violations",
        "observations"
      ],
      "description": "게이트 결과. SKIPPED는 판정 장치가 그 자리를 보지 못했다는 뜻이고 통과가 아니다. allow_missing_gates가 true인 run은 개발용이므로 통과로 읽지 않는다.",
      "properties": {
        "g0": {
          "type": "string",
          "enum": [
            "PASS",
            "REJECT",
            "SKIPPED"
          ]
        },
        "g1": {
          "type": "string",
          "enum": [
            "PASS",
            "REJECT",
            "SKIPPED"
          ]
        },
        "changes": {
          "type": "string",
          "enum": [
            "PASS",
            "REJECT",
            "SKIPPED"
          ]
        },
        "allow_missing_gates": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "contract_result": {
      "type": "object",
      "required": [
        "verdict",
        "contract_errors",
        "checked_rules"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "PASS"
          ]
        },
        "contract_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": [
        "run_id",
        "input",
        "draft",
        "critique",
        "eval"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "draft": {
          "type": "string",
          "minLength": 1
        },
        "critique": {
          "type": "string",
          "minLength": 1
        },
        "eval": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "refine_request": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "string",
      "description": "PASS한 iteration의 커밋. 이것이 run의 산출이다."
    },
    "tag": {
      "type": "string",
      "description": "그 커밋에 달린 태그."
    }
  },
  "additionalProperties": false
}
