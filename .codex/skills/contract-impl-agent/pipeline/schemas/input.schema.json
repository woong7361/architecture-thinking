{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract Conformance Harness Input",
  "description": "계약 기준선과 요구사항 명세만 담는다. 판정 기준(사람이 쓴 feature/step, 루브릭, 테스트 케이스)은 들어가지 않는다.",
  "type": "object",
  "required": ["brief_hash", "created_at", "brief"],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$",
      "description": "한 건을 관통하는 유일 식별자. brief 전체의 정규화 해시 앞 8자."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "입력 파일이 만들어진 시각"
    },
    "brief": {
      "type": "object",
      "required": ["title", "contracts", "scope", "requirement_spec", "implementation_contract"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "구현 대상 한 줄 이름"
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "description": "이 run의 기준선 계약. 원문을 그대로 싣고 sha256으로 못 박는다. Gen이 읽는 기준선과 게이트가 대조하는 기준선이 한 바이트도 달라지지 않게 하는 장치다.",
          "items": {
            "type": "object",
            "required": ["kind", "path", "sha256", "text"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["openapi", "asyncapi"],
                "description": "계약의 종류. asyncapi는 같은 파이프라인의 두 번째 모드다."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "저장소 기준 계약 파일 경로. 판본 계보의 출발점 이름이 된다."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "text의 sha256. 계약 원본과 다르면 손으로 고친 판이라는 뜻이다."
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "계약 원문 그대로. 요약하거나 발췌하지 않는다."
              }
            },
            "additionalProperties": false
          }
        },
        "scope": {
          "type": "object",
          "required": ["operation_ids"],
          "description": "판정 범위. 기준선에서 기계로 뽑되 입력에 적어 두어 구현이 오퍼레이션을 빼먹은 것을 누락으로 셀 수 있게 한다.",
          "properties": {
            "operation_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "requirement_spec": {
          "type": "string",
          "minLength": 1,
          "description": "요구사항 명세 원문. 계약이 값을 정하지 않은 자리와 계약을 고칠 때의 근거다. 계약과 섞지 않는다."
        },
        "implementation_contract": {
          "type": "object",
          "required": ["stack", "layout_rules", "provided_api", "immutable_paths"],
          "description": "스켈레톤의 공개 표면만 싣는다. 전문을 실으면 스켈레톤을 고쳐 계약을 맞추는 길이 열린다.",
          "properties": {
            "stack": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "layout_rules": {
              "type": "array",
              "minItems": 1,
              "description": "층 사이의 의존 방향 규약. ArchUnit 규칙이 같은 말을 강제한다.",
              "items": { "type": "string", "minLength": 1 }
            },
            "provided_api": {
              "type": "array",
              "description": "사람이 소유한 포트 인터페이스 원문. 구현은 이것만 호출한다.",
              "items": {
                "type": "object",
                "required": ["path", "text"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "immutable_paths": {
              "type": "array",
              "description": "건드리면 안 되는 경로. 매니페스트가 이 경로를 담으면 manifest.forbidden_path로 REJECT다.",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "out_of_scope": {
          "type": "array",
          "description": "이 run이 다루지 않는 것. 구현이 범위 밖을 채우려 드는 것을 막는다.",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
