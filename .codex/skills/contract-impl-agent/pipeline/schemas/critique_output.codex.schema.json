{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critique Output (model-facing)",
  "description": "codex --output-schema 전용. 모든 객체의 required가 properties의 모든 키를 담고 선택 필드는 널 허용이다. 판정은 critique_output.schema.json이 한다. runner가 붙이는 unjustified_proposal은 모델이 내는 것이 아니므로 여기에 없다.",
  "type": "object",
  "required": [
    "brief_hash",
    "iteration",
    "summary",
    "strengths",
    "weaknesses",
    "revision_directions",
    "contract_review",
    "contested_decisions",
    "reader_risks"
  ],
  "properties": {
    "brief_hash": { "type": "string" },
    "iteration": { "type": "string" },
    "summary": { "type": "string" },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": {
      "type": "array",
      "description": "다섯 축에 붙인 고칠 방향. axis는 루브릭의 축 이름이어야 한다.",
      "items": {
        "type": "object",
        "required": ["id", "axis", "issue", "why_it_matters", "suggestion", "severity", "target"],
        "properties": {
          "id": { "type": "string" },
          "axis": { "type": "string" },
          "issue": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "suggestion": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "target": {
            "type": ["object", "null"],
            "description": "표면이나 계약을 건드리는 제안에만 붙인다. 아니면 null. scope가 code면 구현을 고치라는 것이고 contract면 계약을 고치라는 발의다.",
            "required": ["pointer", "action", "scope"],
            "properties": {
              "pointer": { "type": "string" },
              "action": { "type": "string", "enum": ["remove", "add", "rename", "relax", "tighten"] },
              "scope": { "type": "string", "enum": ["code", "contract"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "revision_directions": { "type": "array", "items": { "type": "string" } },
    "contract_review": {
      "type": "array",
      "description": "계약 자체에 대한 비평. 변경 발의는 여기서만 나온다.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "pointer", "finding", "proposed_change", "action", "spec_anchor", "severity"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["proposal", "prior_change_review", "observation_meaning", "harmful_choice"]
          },
          "pointer": { "type": "string" },
          "finding": { "type": "string" },
          "proposed_change": {
            "type": "string",
            "description": "kind가 proposal이면 무엇을 어떻게 고칠지. 아니면 빈 문자열."
          },
          "action": {
            "type": ["string", "null"],
            "enum": ["remove", "add", "rename", "relax", "tighten", null],
            "description": "발의한 변경의 종류. 발의가 아니면 null."
          },
          "spec_anchor": {
            "type": "string",
            "description": "명세의 요구사항 id나 계약의 슬롯. 비면 runner가 unjustified_proposal로 표시한다."
          },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    },
    "contested_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "objection", "alternative", "severity"],
        "properties": {
          "decision_id": { "type": "string" },
          "objection": { "type": "string" },
          "alternative": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    },
    "reader_risks": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
