<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- taskE-5 조각 A: 생성된 구현 초안을 떨어뜨려 컴파일·부팅하고 springdoc이 내는
         /v3/api-docs 를 받아내기 위한 스켈레톤이다. 사람이 소유하며 생성기는 고칠 수 없다.
         - 판정에 필요한 것만 넣는다. 외부 예약처는 포트의 인메모리 구현으로 대체하고
           저장도 인메모리이므로 JPA·MySQL·Testcontainers는 의존에 두지 않는다.
         - 게이트가 iteration마다 부팅하므로 부팅이 빠른 쪽을 택했다.
         - 인수테스트(cucumber)는 이 조각의 판정 수단이 아니라서 넣지 않는다. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.thinking</groupId>
    <artifactId>tennis-alert-skeleton</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.6.0</springdoc.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 게이트의 스펙 추출기다. 부팅한 애플리케이션에서 /v3/api-docs 를 뽑아 계약과 대조한다.
             사람이 읽는 화면은 판정에 쓰이지 않으므로 ui 없이 api 모듈만 쓴다. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- 패키지 경계를 리뷰어의 눈이 아니라 빨간불로 판정한다.
             생성 코드가 아직 없는 빈 상태에서도 통과해야 하므로 규칙마다 allowEmptyShould 를 켠다. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
