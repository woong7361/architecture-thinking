  "contested_decisions": [
    {
      "decision_id": "d_create_slot_validation",
      "objection": "선택한 검증 경로는 신청 생성이 저장 결과가 없을 때 외부 확인을 일으킬 수 있도록 범위를 넓힌다. 그러나 계약 산문과 요구사항은 확인을 일으키는 오퍼레이션을 availability 조회로 한정한다. 운영 시간대 검증에 availability 결과를 쓰는 것과 조회를 새로 발생시키는 것은 같은 결정이 아니다.",
      "alternative": "createAlert는 기존에 저장된 운영 시간대 또는 확인 결과만 읽는다. 필요한 정보가 없을 때의 신청 가능 여부를 계약에 명시하거나, 외부 확인은 GET에서만 수행하도록 경계를 유지한다.",
      "severity": "high"
    },
    {
      "decision_id": "d_bearer_identity",
      "objection": "Bearer 값 전체를 사용자 키로 삼는 선택은 토큰 검증이 없다는 사실을 숨긴 채 임의의 비어 있지 않은 문자열을 인증 주체로 승격한다. 계약이 검증 체계를 정하지 않았다는 사실은 유효성 검사를 생략해도 된다는 근거가 아니다.",
      "alternative": "인증 검증을 담당하는 명시적 경계를 두고 검증된 주체만 유스케이스에 전달한다. 인증 제공자를 이 범위에서 정할 수 없다면 계약에 제한을 드러내고 이 구현의 사용자 키를 실제 Bearer 인증으로 간주하지 않는다.",
      "severity": "high"
    }
  ],
  "code_instructions": [
    {
      "id": "create-refresh-boundary",
      "axis": "state_continuity",
      "issue": "AlertApplicationService.ensureSlotSupported의 선택이 AvailabilityApplicationService를 통해 저장 결과가 없거나 오래된 경우 외부 확인까지 일으키는 경로를 허용한다. 초안의 결정 기록도 신청 생성 중 확인을 일으킬 수 있다고 명시한다.",
      "suggestion": "신청 생성에서는 이미 저장된 권위 있는 운영 시간대·확인 결과만 읽어 검증하고 외부 확인이나 캐시 갱신은 수행하지 않도록 고친다. 저장된 정보만으로 판단할 수 없는 경우의 처리 규칙이 필요하다면 먼저 계약에 그 경우를 명시한 뒤 구현한다.",
      "severity": "high",
