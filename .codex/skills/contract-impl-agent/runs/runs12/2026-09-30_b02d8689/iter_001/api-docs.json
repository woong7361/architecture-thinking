  "components": {
    "schemas": {
      "AlertRequest": {
        "required": [
          "courtId",
          "date",
          "slot"
        ],
        "type": "object",
        "properties": {
          "courtId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string",
            "description": "서비스가 지원하는 코트의 식별자",
            "example": "seoul-yangjae-1"
          },
          "date": {
            "type": "string",
            "description": "이용하려는 날짜. 코트가 있는 지역의 날짜다.",
            "format": "date",
            "example": "2026-10-04"
          },
          "slot": {
            "$ref": "#/components/schemas/TimeSlot"
          }
        },
        "description": "알림 신청 조건. 코트 하나, 날짜 하나, 시간대 하나다."
      },
      "TimeSlot": {
        "required": [
          "endTime",
          "startTime"
        ],
        "type": "object",
        "properties": {
          "startTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string",
            "description": "코트가 있는 지역 기준 시작 시각",
            "example": "06:00"
          },
          "endTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string",
            "description": "코트가 있는 지역 기준 종료 시각",
            "example": "08:00"
          }
        },
        "description": "예약 단위가 되는 시간대. 코트가 운영하는 시간대와 정확히 일치해야 한다."
      },
      "Problem": {
        "required": [
          "code",
          "retryable",
          "status",
          "title",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "이 실패 종류를 설명하는 문서의 주소",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "description": "사람이 읽는 실패 이름"
          },
          "status": {
            "type": "integer",
            "description": "HTTP 상태 코드. 응답의 상태 코드와 같다.",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "description": "이번 실패에만 해당하는 설명"
          },
          "instance": {
            "type": "string",
            "description": "실패가 난 요청의 경로",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "description": "실패의 원인을 가리키는 코드. 클라이언트의 대응이 갈리는 자리마다 코드 하나를 둔다.\n대응이 같은 두 상황에는 코드를 따로 두지 않는다. 구별해도 클라이언트가 분기할 일이 없어 무시된다.\n\n- `VALIDATION_FAILED`: 요청의 형식이나 값이 스키마를 만족하지 않는다. 필수인 `Idempotency-Key` 헤더가 없거나 그 값이 UUID가 아닌 경우도 여기에 든다.\n- `UNAUTHENTICATED`: 토큰이 없거나 유효하지 않아 사용자를 식별할 수 없다.\n- `COURT_NOT_SUPPORTED`: 서비스가 지원하지 않는 코트다. 경로에서 받았으면 404, 본문에서 받았으면 422로 나간다.\n- `SLOT_NOT_SUPPORTED`: 코트는 지원하지만 그 코트가 그 날짜에 운영하지 않는 시간대다.\n- `ALERT_WINDOW_CLOSED`: 만료 시각이 이미 지나 감시할 수 없는 조건이다.\n- `ALERT_NOT_FOUND`: 그런 신청이 없거나 요청한 사용자의 것이 아니다.\n- `IDEMPOTENCY_KEY_REUSED`: 같은 키가 다른 내용의 요청에 이미 쓰였다.\n- `UPSTREAM_TIMEOUT`: 외부 예약처가 정해진 시간 안에 응답하지 않았다.\n- `UPSTREAM_UNAVAILABLE`: 외부 예약처에 닿지 못했거나 예약처가 실패를 돌려줬다.\n- `UPSTREAM_RESPONSE_UNREADABLE`: 외부 예약처의 응답을 읽지 못했다.\n- `STORAGE_TIMEOUT`: 저장소가 정해진 시간 안에 응답하지 않았다.\n- `CONCURRENT_UPDATE_CONFLICT`: 같은 자원을 동시에 고치려다 경합에 밀렸다. 같은 멱등 키의 앞선 요청이 아직 처리 중이라 물러난 경우도 여기에 든다.\n- `INTERNAL_ERROR`: 위 어디에도 해당하지 않는 서버 내부 실패다. 상태를 바꾸는 오퍼레이션은 멱등 키를 요구하므로 같은 요청을 그대로 다시 보내도 안전하다.\n",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "COURT_NOT_SUPPORTED",
              "SLOT_NOT_SUPPORTED",
              "ALERT_WINDOW_CLOSED",
              "ALERT_NOT_FOUND",
              "IDEMPOTENCY_KEY_REUSED",
              "UPSTREAM_TIMEOUT",
              "UPSTREAM_UNAVAILABLE",
              "UPSTREAM_RESPONSE_UNREADABLE",
              "STORAGE_TIMEOUT",
              "CONCURRENT_UPDATE_CONFLICT",
              "INTERNAL_ERROR"
            ]
          },
          "retryable": {
            "type": "boolean",
            "description": "같은 요청을 그대로 다시 보내 결과가 달라질 수 있으면 true다.\nfalse이면 요청이나 조건을 바꾸지 않는 한 몇 번을 보내도 같은 실패가 난다.\n"
          },
          "retryAfterSeconds": {
            "minimum": 1,
            "type": "integer",
            "description": "다시 시도하기까지 기다릴 초",
            "format": "int32"
          },
          "traceId": {
            "type": "string",
            "description": "서버 로그에서 이 요청을 찾는 식별자다. 사용자가 실패를 신고할 때 이 값으로 로그를 찾는다.\n5xx에만 오고 4xx에는 오지 않는다.\n"
          }
        },
        "description": "RFC 9457 형식의 실패 응답이다. `code`가 원인을 가리키고 `retryable`이 클라이언트의 다음 행동을 정한다.\n`retryable`이 true이면 `retryAfterSeconds`와 `Retry-After` 헤더가 반드시 함께 온다.\n`traceId`는 5xx에만 싣는다. 4xx는 클라이언트가 요청을 고치면 풀려 서버 로그를 찾을 일이 없다.\n두 조건 모두 스키마로는 적을 수 없어 계약 검사 스크립트가 대신 판정한다.\n"
      },
      "Alert": {
        "required": [
          "alertId",
          "checkDelayed",
          "courtId",
          "courtName",
          "createdAt",
          "date",
          "delivery",
          "expiresAt",
          "lastCheckedAt",
          "reservationUrl",
          "slot",
          "status"
        ],
        "type": "object",
        "properties": {
          "alertId": {
            "type": "string",
            "description": "알림 신청의 식별자. 서버가 신청을 만들 때 발급한다.",
            "format": "uuid",
            "example": "6f5b2f7e-9c1a-4f0e-9a4c-2b7d5e1a8c30"
          },
