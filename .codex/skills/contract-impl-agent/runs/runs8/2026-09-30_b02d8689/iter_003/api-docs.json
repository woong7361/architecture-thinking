{
  "openapi": "3.0.1",
  "info": {
    "title": "Tennis court availability alert API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tennis-alert.example.com/v1"
    }
  ],
  "paths": {
    "/courts/{courtId}/availability": {
      "get": {
        "tags": [
          "availability-controller"
        ],
        "operationId": "getCourtAvailability",
        "parameters": [
          {
            "name": "courtId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Availability unavailable.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter",
                "style": "simple"
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "x-error-codes": "[\"UPSTREAM_UNAVAILABLE\",\"STORAGE_TIMEOUT\"]"
          },
          "504": {
            "description": "Upstream timeout.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter",
                "style": "simple"
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "x-error-codes": "[\"UPSTREAM_TIMEOUT\"]"
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "x-error-codes": "[\"VALIDATION_FAILED\"]"
          },
          "502": {
            "description": "Upstream response unreadable.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter",
                "style": "simple"
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "x-error-codes": "[\"UPSTREAM_RESPONSE_UNREADABLE\"]"
          },
          "200": {
            "description": "Availability result.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "x-error-codes": "[]"
          },
          "404": {
            "description": "Court not supported.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "x-error-codes": "[\"COURT_NOT_SUPPORTED\"]"
          },
          "500": {
            "description": "Internal error.",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter",
                "style": "simple"
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            },
            "x-error-codes": "[\"INTERNAL_ERROR\"]"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string"
          },
          "courtName": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "staleReason": {
            "type": "string"
          },
          "reservationUrl": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlotResponse"
            }
          }
        }
      },
      "AvailabilitySlotResponse": {
        "type": "object",
        "properties": {
          "startTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "endTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
