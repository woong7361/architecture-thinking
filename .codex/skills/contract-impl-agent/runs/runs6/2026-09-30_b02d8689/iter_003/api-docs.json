{
  "openapi": "3.0.1",
  "info": {
    "title": "테니스 코트 빈자리 알림 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tennis-alert.example.com/v1"
    }
  ],
  "paths": {
    "/alerts": {
      "get": {
        "tags": [
          "alert-controller"
        ],
        "summary": "내 알림 신청 목록 조회",
        "operationId": "listAlerts",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "STORAGE_TIMEOUT"
            ]
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertList"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UNAUTHENTICATED"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "alert-controller"
        ],
        "summary": "빈자리 알림 신청",
        "operationId": "createAlert",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRequest"
              }
            }
          }
        },
        "responses": {
          "502": {
            "description": "예약처 응답을 읽지 못함",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UPSTREAM_RESPONSE_UNREADABLE"
            ]
          },
          "422": {
            "description": "신청 조건을 받아들일 수 없음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "COURT_NOT_SUPPORTED",
              "SLOT_NOT_SUPPORTED",
              "ALERT_WINDOW_CLOSED"
            ]
          },
          "201": {
            "description": "신청이 만들어졌다.",
            "headers": {
              "Idempotency-Replayed": {
                "required": true,
                "style": "simple"
              },
              "Location": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                }
              }
            }
          },
          "409": {
            "description": "멱등 키 재사용",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "IDEMPOTENCY_KEY_REUSED"
            ]
          },
          "401": {
            "description": "인증이 필요함",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "503": {
            "description": "일시적으로 처리할 수 없음",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UPSTREAM_UNAVAILABLE",
              "STORAGE_TIMEOUT",
              "CONCURRENT_UPDATE_CONFLICT"
            ]
          },
          "500": {
            "description": "서버 내부 오류",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ]
          },
          "504": {
            "description": "예약처 시간 초과",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UPSTREAM_TIMEOUT"
            ]
          },
          "200": {
            "description": "이미 감시 중인 신청",
            "headers": {
              "Idempotency-Replayed": {
                "required": true,
                "style": "simple"
              },
              "Location": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                }
              }
            }
          },
          "400": {
            "description": "요청이 올바르지 않음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_FAILED"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/courts/{courtId}/availability": {
      "get": {
        "tags": [
          "availability-controller"
        ],
        "summary": "코트·날짜의 예약 상태 조회",
        "operationId": "getCourtAvailability",
        "parameters": [
          {
            "name": "courtId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "504": {
            "description": "예약처가 제때 응답하지 않았습니다",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UPSTREAM_TIMEOUT"
            ]
          },
          "500": {
            "description": "서버 내부 오류",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ]
          },
          "400": {
            "description": "요청 값이 올바르지 않습니다",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "200": {
            "description": "예약 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailability"
                }
              }
            }
          },
          "502": {
            "description": "예약처 응답을 읽지 못했습니다",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UPSTREAM_RESPONSE_UNREADABLE"
            ]
          },
          "503": {
            "description": "예약처에 연결하지 못했습니다",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UPSTREAM_UNAVAILABLE",
              "STORAGE_TIMEOUT"
            ]
          },
          "404": {
            "description": "지원하지 않는 코트입니다",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "COURT_NOT_SUPPORTED"
            ]
          }
        }
      }
    },
    "/alerts/{alertId}": {
      "get": {
        "tags": [
          "alert-controller"
        ],
        "summary": "알림 신청 단건 조회",
        "operationId": "getAlert",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "ALERT_NOT_FOUND"
            ]
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "STORAGE_TIMEOUT"
            ]
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UNAUTHENTICATED"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "alert-controller"
        ],
        "summary": "알림 신청 해제",
        "operationId": "cancelAlert",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "ALERT_NOT_FOUND"
            ]
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Alert"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "STORAGE_TIMEOUT",
              "CONCURRENT_UPDATE_CONFLICT"
            ]
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "Retry-After": {
                "required": true,
                "style": "simple"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ]
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "x-error-codes": [
              "UNAUTHENTICATED"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AlertRequest": {
        "required": [
          "courtId",
          "date",
          "slot"
        ],
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "slot": {
            "$ref": "#/components/schemas/TimeSlot"
          }
        }
      },
      "TimeSlot": {
        "required": [
          "endTime",
          "startTime"
        ],
        "type": "object",
        "properties": {
          "startTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "endTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          }
        }
      },
      "Problem": {
        "required": [
          "code",
          "retryable",
          "status",
          "title",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "nullable": true
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "COURT_NOT_SUPPORTED",
              "SLOT_NOT_SUPPORTED",
              "ALERT_WINDOW_CLOSED",
              "ALERT_NOT_FOUND",
              "IDEMPOTENCY_KEY_REUSED",
              "UPSTREAM_TIMEOUT",
              "UPSTREAM_UNAVAILABLE",
              "UPSTREAM_RESPONSE_UNREADABLE",
              "STORAGE_TIMEOUT",
              "CONCURRENT_UPDATE_CONFLICT",
              "INTERNAL_ERROR"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "retryAfterSeconds": {
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Alert": {
        "required": [
          "alertId",
          "checkDelayed",
          "courtId",
          "courtName",
          "createdAt",
          "date",
          "delivery",
          "expiresAt",
          "lastCheckedAt",
          "reservationUrl",
          "slot",
          "status"
        ],
        "type": "object",
        "properties": {
          "alertId": {
            "type": "string",
            "format": "uuid"
          },
          "courtId": {
            "type": "string"
          },
          "courtName": {
            "type": "string"
          },
          "reservationUrl": {
            "type": "string",
            "format": "uri"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "slot": {
            "$ref": "#/components/schemas/TimeSlot"
          },
          "status": {
            "type": "string",
            "enum": [
              "WATCHING",
              "NOTIFIED",
              "CANCELED",
              "EXPIRED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastCheckedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "checkDelayed": {
            "type": "boolean"
          },
          "delivery": {
            "$ref": "#/components/schemas/AlertDelivery"
          }
        }
      },
      "AlertDelivery": {
        "required": [
          "attemptCount",
          "failureReason",
          "lastAttemptAt",
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SENT",
              "FAILED"
            ]
          },
          "attemptCount": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "lastAttemptAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          }
        },
        "nullable": true
      },
      "AvailabilitySlot": {
        "required": [
          "available",
          "endTime",
          "startTime"
        ],
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "CourtAvailability": {
        "required": [
          "confirmedAt",
          "courtId",
          "courtName",
          "date",
          "reservationUrl",
          "slots",
          "stale",
          "staleReason"
        ],
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string"
          },
          "courtName": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "staleReason": {
            "type": "string",
            "nullable": true
          },
          "reservationUrl": {
            "type": "string",
            "format": "uri"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlot"
            }
          }
        }
      },
      "AlertList": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "사용자를 식별한다. 토큰이 가리키는 사용자만 자기 신청을 조회하고 해제할 수 있다.",
        "scheme": "bearer"
      }
    }
  }
}
