{
  "openapi": "3.0.1",
  "info": {
    "title": "테니스 코트 빈자리 알림 API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.tennis-alert.example.com/v1"
    }
  ],
  "tags": [
    {
      "name": "alerts",
      "description": "빈자리 알림 신청의 생성, 조회, 해제"
    },
    {
      "name": "availability",
      "description": "외부 예약처에서 가져온 예약 상태 조회"
    }
  ],
  "paths": {
    "/alerts": {
      "get": {
        "tags": [
          "alerts"
        ],
        "operationId": "listAlerts",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "본인의 신청 목록",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            }
          },
          "401": {
            "description": "사용자를 식별하지 못해 본인 것인지 판단할 수 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부에서 처리하지 못했다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 자체가 스키마를 만족하지 않아 처리하지 않았다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            }
          },
          "503": {
            "description": "저장소가 제때 응답하지 않아 처리하지 못했다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "alerts"
        ],
        "operationId": "createAlert",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRequest"
              }
            }
          }
        },
        "responses": {
          "409": {
            "description": "멱등 키가 앞선 요청의 내용과 어긋난다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "201": {
            "description": "신청이 만들어졌다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청이 스키마를 만족하지 않는다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "503": {
            "description": "저장소가 제때 응답하지 않았거나 같은 자원을 고치려는 요청끼리 경합에 밀렸다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "200": {
            "description": "같은 조건을 감시 중인 신청이 이미 있어 그 신청을 돌려준다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "401": {
            "description": "사용자를 식별하지 못해 본인 것인지 판단할 수 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부에서 처리하지 못했다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "422": {
            "description": "요청 형식은 맞지만 본문이 가리킨 조건을 감시할 수 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/courts/{courtId}/availability": {
      "get": {
        "tags": [
          "availability"
        ],
        "operationId": "getCourtAvailability",
        "parameters": [
          {
            "name": "courtId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "저장된 마지막 확인 결과",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailabilityResponse"
                }
              }
            }
          },
          "404": {
            "description": "경로가 가리킨 코트를 서비스가 다루지 않는다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailabilityResponse"
                }
              }
            }
          },
          "504": {
            "description": "외부 예약처가 제때 응답하지 않았고 저장된 마지막 성공 결과도 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailabilityResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부에서 처리하지 못했다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailabilityResponse"
                }
              }
            }
          },
          "502": {
            "description": "외부 예약처의 응답을 읽지 못했고 저장된 마지막 성공 결과도 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailabilityResponse"
                }
              }
            }
          },
          "503": {
            "description": "예약 상태를 돌려줄 수 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 자체가 스키마를 만족하지 않아 처리하지 않았다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CourtAvailabilityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/{alertId}": {
      "get": {
        "tags": [
          "alerts"
        ],
        "operationId": "getAlert",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "신청 하나",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "401": {
            "description": "사용자를 식별하지 못해 본인 것인지 판단할 수 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부에서 처리하지 못했다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 자체가 스키마를 만족하지 않아 처리하지 않았다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "404": {
            "description": "없는 신청과 남의 신청을 구분해 알리지 않는다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "503": {
            "description": "저장소가 제때 응답하지 않아 처리하지 못했다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "alerts"
        ],
        "operationId": "cancelAlert",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "저장소가 제때 응답하지 않았거나 같은 자원을 고치려는 요청끼리 경합에 밀렸다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "401": {
            "description": "사용자를 식별하지 못해 본인 것인지 판단할 수 없다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부에서 처리하지 못했다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "200": {
            "description": "해제 요청을 처리한 뒤의 신청 상태",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 자체가 스키마를 만족하지 않아 처리하지 않았다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "404": {
            "description": "없는 신청과 남의 신청을 구분해 알리지 않는다.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AlertRequest": {
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "slot": {
            "$ref": "#/components/schemas/TimeSlotRequest"
          }
        }
      },
      "TimeSlotRequest": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          }
        }
      },
      "AlertDeliveryResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "attemptCount": {
            "type": "integer",
            "format": "int32"
          },
          "lastAttemptAt": {
            "type": "string"
          },
          "failureReason": {
            "type": "string"
          }
        }
      },
      "AlertResponse": {
        "type": "object",
        "properties": {
          "alertId": {
            "type": "string"
          },
          "courtId": {
            "type": "string"
          },
          "courtName": {
            "type": "string"
          },
          "reservationUrl": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "slot": {
            "$ref": "#/components/schemas/TimeSlotResponse"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "lastCheckedAt": {
            "type": "string"
          },
          "checkDelayed": {
            "type": "boolean"
          },
          "delivery": {
            "$ref": "#/components/schemas/AlertDeliveryResponse"
          }
        }
      },
      "TimeSlotResponse": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          }
        }
      },
      "AvailabilitySlotResponse": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "CourtAvailabilityResponse": {
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string"
          },
          "courtName": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "confirmedAt": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          },
          "staleReason": {
            "type": "string"
          },
          "reservationUrl": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlotResponse"
            }
          }
        }
      },
      "AlertListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "사용자를 식별한다. 토큰이 가리키는 사용자만 자기 신청을 조회하고 해제할 수 있다.",
        "scheme": "bearer"
      }
    }
  }
}
