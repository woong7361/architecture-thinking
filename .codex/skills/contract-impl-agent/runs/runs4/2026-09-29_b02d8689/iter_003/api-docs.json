          },
          "endTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "CourtAvailability": {
        "required": [
          "confirmedAt",
          "courtId",
          "courtName",
          "date",
          "reservationUrl",
          "slots",
          "stale",
          "staleReason"
        ],
        "type": "object",
        "properties": {
          "courtId": {
            "type": "string"
          },
          "courtName": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "staleReason": {
            "type": "string",
            "nullable": true
          },
          "reservationUrl": {
            "type": "string",
            "format": "uri"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlot"
            }
          }
        }
      },
      "AlertList": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
