{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gen 산출 — 주장과 근거",
  "description": "조사자의 산출. 판정 칸이 없다. Gen이 '뒷받침함'을 쓰면 뒤 단계가 그 문장을 전제로 받아 확인만 하게 된다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "sentence", "sites", "decides_at", "citations", "source_says", "claim_delta"],
        "properties": {
          "id": { "type": "string", "pattern": "^claim-[0-9]{2}$" },
          "kind": {
            "enum": ["fact", "choice"],
            "description": "fact는 1차 출처 하나의 인용으로 참·거짓이 갈린다. choice는 출처가 말해 줄 수 없고 대상 코드가 그 방식을 택했다는 것이다."
          },
          "sentence": { "type": "string", "minLength": 10, "maxLength": 400 },
          "sites": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^site-[0-9]{2}$" },
            "description": "이 주장이 덮는 지점 id. 좌표 문자열이 아니라 id로 적는다."
          },
          "decides_at": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["source", "doc"] },
              "symbols": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "section": { "type": "string" }
            },
            "description": "주장이 참·거짓으로 갈리는 자리. source면 symbols, doc이면 section을 쓴다."
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "quote"],
              "properties": {
                "path": { "type": "string", "minLength": 3 },
                "quote": { "type": "string", "minLength": 5 }
              }
            }
          },
          "source_says": {
            "type": "string",
            "minLength": 10,
            "description": "원문이 말하는 것. 주장을 되풀이하지 않고 원문의 범위로 적는다."
          },
          "claim_delta": {
            "type": "string",
            "minLength": 5,
            "description": "주장 문장과 원문의 차이. 없으면 없다고 적는다."
          },
          "searched": {
            "type": "array",
            "items": { "type": "string" },
            "description": "제한 조항을 찾으려고 뒤진 1차 출처 경로."
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "statement", "coordinate"],
              "properties": {
                "dimension": { "enum": ["latency", "resource", "failure", "complexity"] },
                "statement": {
                  "type": "string",
                  "minLength": 10,
                  "description": "대안 대비 무엇을 얻고 무엇을 치르는지. 또는 그 차원에서 교환이 없다는 것과 왜 없는지."
                },
                "coordinate": {
                  "type": "string",
                  "minLength": 3,
                  "description": "그 서술을 뒷받침하는 좌표. 1차 출처의 경로나 측정 로그의 경로와 줄."
                },
                "premise": {
                  "type": "string",
                  "description": "이 교환이 성립하는 전제. 충돌 빈도, 요청 분포, 인스턴스 수, 허용 대기 시간 중 해당하는 것."
                },
                "inverts_at": {
                  "type": "string",
                  "description": "그 전제가 뒤집히는 값. 어느 수치를 넘으면 반대가 되는지."
                }
              }
            },
            "description": "kind가 choice인 주장에만 적는다. fact 주장에는 두지 않는다."
          }
        }
      }
    }
  }
}
