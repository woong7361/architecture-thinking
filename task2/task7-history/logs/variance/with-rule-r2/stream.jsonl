\n53\t    public void 이미_예약된_티켓이_있다(int price, long ticketId) {\n54\t        TicketRecord reserved = new TicketRecord(ticketId, price);\n55\t        reserved.setReserved(true);\n56\t        reserved.setUserId(-1L);\n57\t        ticketStore.seed(reserved);\n58\t    }\n59\t\n60\t    @Given(\"회원 {long}이 이미 티켓 {long}을 예약해 두었다\")\n61\t    public void 이미_티켓을_예약해_두었다(long userId, long ticketId) {\n62\t        TicketRecord owned = new TicketRecord(ticketId, 30000);\n63\t        owned.setReserved(true);\n64\t        owned.setUserId(userId);\n65\t        ticketStore.seed(owned);\n66\t    }\n67\t\n68\t    @Given(\"결제는 거절되는 상황이다\")\n69\t    public void 결제는_거절된다() {\n70\t        this.paymentApi = PaymentApi.failing();\n71\t    }\n72\t\n73\t    // --- When ---\n74\t\n75\t    @When(\"회원 {long}이 카드정보 {string}으로 티켓 {long}을 예매하면\")\n76\t    public void 예매하면(long userId, String paymentInfo, long ticketId) {\n77\t        TicketService service = new TicketService(ticketStore, userStore, paymentApi);\n78\t        try {\n79\t            this.result = service.reserveTicket(userId, ticketId, paymentInfo);\n80\t        } catch (Throwable t) {\n81\t            this.thrown = t;\n82\t        }\n83\t    }\n84\t\n85\t    // --- Then ---\n86\t\n87\t    @Then(\"예매는 성공한다\")\n88\t    public void 예매는_성공한다() {\n89\t        assertThat(thrown).isNull();\n90\t        assertThat(result).isTrue();\n91\t    }\n92\t\n93\t    @Then(\"티켓 {long}은 회원 {long}에게 예약된다\")\n94\t    public void 티켓이_회원에게_예약된다(long ticketId, long userId) {\n95\t        TicketRecord stored = ticketStore.findById(ticketId);\n96\t        assertThat(stored.isReserved()).isTrue();\n97\t        assertThat(stored.getUserId()).isEqualTo(userId);\n98\t    }\n99\t\n100\t    @Then(\"{int}원이 청구된다\")\n101\t    public void 금액이_청구된다(int amount) {\n102\t        assertThat(paymentApi.wasCharged()).isTrue();\n103\t        assertThat(paymentApi.lastAmount()).isEqualTo(amount);\n104\t    }\n105\t\n106\t    @Then(\"예매는 회원 없음으로 거부된다\")\n107\t    public void 회원