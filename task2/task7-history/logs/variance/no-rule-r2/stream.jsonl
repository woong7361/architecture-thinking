{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YCF92vhVQHV2S3qJMs2QnH","type":"tool_result","content":"1\tpackage com.thinking.ticket.steps;\n2\t\n3\timport static org.assertj.core.api.Assertions.assertThat;\n4\t\n5\timport com.thinking.ticket.PaymentFailedException;\n6\timport com.thinking.ticket.TicketAlreadyReservedException;\n7\timport com.thinking.ticket.TicketLimitExceededException;\n8\timport com.thinking.ticket.TicketService;\n9\timport com.thinking.ticket.UserNotFoundException;\n10\timport com.thinking.ticket.provided.PaymentApi;\n11\timport com.thinking.ticket.provided.TicketRecord;\n12\timport com.thinking.ticket.provided.TicketStore;\n13\timport com.thinking.ticket.provided.UserRecord;\n14\timport com.thinking.ticket.provided.UserStore;\n15\t\n16\timport io.cucumber.java.en.Given;\n17\timport io.cucumber.java.en.Then;\n18\timport io.cucumber.java.en.When;\n19\t\n20\t/**\n21\t * 예매 유스케이스 경계의 인수테스트 step 정의. C2(1인 1매 제한) 시점.\n22\t *\n23\t * <p>진입점과 생성자는 baseline 그대로다 — C2는 규칙 하나만 느는 변경이다.\n24\t */\n25\tpublic final class TicketReservationSteps {\n26\t\n27\t    private final UserStore userStore = new UserStore();\n28\t    private final TicketStore ticketStore = new TicketStore();\n29\t    private PaymentApi paymentApi = PaymentApi.succeeding();\n30\t\n31\t    private Boolean result;\n32\t    private Throwable thrown;\n33\t\n34\t    // --- Given ---\n35\t\n36\t    @Given(\"회원 저장소와 티켓 저장소가 비어 있다\")\n37\t    public void 저장소가_비어_있다() {\n38\t        this.result = null;\n39\t        this.thrown = null;\n40\t    }\n41\t\n42\t    @Given(\"회원 {long}이 등록되어 있다\")\n43\t    public void 회원이_등록되어_있다(long userId) {\n44\t        userStore.seed(new UserRecord(userId, \"user-\" + userId));\n45\t    }\n46\t\n47\t    @Given(\"가격 {int}원짜리 미예약 티켓 {long}이 있다\")\n48\t    public void 미예약_티켓이_있다(int price, long ticketId) {\n49\t        ticketStore.seed(new TicketRecord(ticketId, price));\n50\t    }\n51\t\n52\t    @Given(\"가격 {int}원짜리 이미 예약된 티켓 {long}이 있다\")\n53\t    public void 이미_예약된_티켓이_있다(int price, long ticketId) {\n54\t        TicketRecord reserved = new TicketRecord(ticketId, price);\n55\t        reserved.setReserved(true);\n56\t        reserved.setUserId(-1L);\n57\t        ticketStore.seed(reserved);\n58\t    }\n59\t\n60\t    @Given(\"회원 {long}이 이미 티켓 {long}을 예약해 두었다\")\n61\t    public void 이미_티켓을_예약해_두었다(long userId, long ticketId) {\n62\t        TicketRecord owned = new TicketRecord(ticketId, 30000);\n63\t        owned.setReserved(true);\n64\t        owned.setUserId(userId);\n65\t        ticketStore.seed(owned);\n66\t    }\n67\t\n68\t    @Given(\"결제는 거절되는 상황이다\")\n69\t    public void 결제는_거절된다() {\n70\t        this.paymentApi = PaymentApi.failing();\n71\t    }\n72\t\n73\t    // --- When ---\n74\t\n75\t    @When(\"회원 {long}이 카드정보 {string}으로 티켓 {long}을 예매하면\")\n76\t    public void 예매하면(long userId, String paymentInfo, long ticketId) {\n77\t        TicketService service = new TicketService(ticketStore, userStore, paymentApi);\n78\t        try {\n79\t            this.result = service.reserveTicket(userId, ticketId, paymentInfo);\n80\t        } catch (Throwable t) {\n81\t            this.thrown = t;\n82\t        }\n83\t    }\n84\t\n85\t    // --- Then ---\n86\t\n87\t    @Then(\"예매는 성공한다\")\n88\t    public void 예매는_성공한다() {\n89\t        assertThat(thrown).isNull();\n90\t        assertThat(result).isTrue();\n91\t    }\n92\t\n93\t    @Then(\"티켓 {long}은 회원 {long}에게 예약된다\")\n94\t    public void 티켓이_회원에게_예약된다(long ticketId, long userId) {\n95\t        TicketRecord stored = ticketStore.findById(ticketId);\n96\t        assertThat(stored.isReserved()).isTrue();\n97\t        assertThat(stored.getUserId()).isEqualTo(userId);\n98\t    }\n99\t\n100\t    @Then(\"{int}원이 청구된다\")\n101\t    public void 금액이_청구된다(int amount) {\n102\t        assertThat(paymentApi.wasCharged()).isTrue();\n103\t        assertThat(paymentApi.lastAmount()).isEqualTo(amount);\n104\t    }\n105\t\n106\t    @Then(\"예매는 회원 없음으로 거부된다\")\n107\t    public void 회원