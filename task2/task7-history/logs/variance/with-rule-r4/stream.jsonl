{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S8b9rryQXLJEiiiLsg9P8j","type":"tool_result","content":"1\tpackage com.thinking.ticket.steps;\n2\t\n3\timport static org.assertj.core.api.Assertions.assertThat;\n4\t\n5\timport com.thinking.ticket.PaymentFailedException;\n6\timport com.thinking.ticket.TicketAlreadyReservedException;\n7\timport com.thinking.ticket.TicketLimitExceededException;\n8\timport com.thinking.ticket.TicketService;\n9\timport com.thinking.ticket.UserNotFoundException;\n10\timport com.thinking.ticket.provided.PaymentApi;\n11\timport com.thinking.ticket.provided.TicketRecord;\n12\timport com.thinking.ticket.provided.TicketStore;\n13\timport com.thinking.ticket.provided.UserRecord;\n14\timport com.thinking.ticket.provided.UserStore;\n15\t\n16\timport io.cucumber.java.en.Given;\n17\timport io.cucumber.java.en.Then;\n18\timport io.cucumber.java.en.When;\n19\t\n20\t/**\n21\t * 예매 유스케이스 경계의 인수테스트 step 정의. C2(1인 1매 제한) 시점.\n22\t *\n23\t * <p>진입점과 생성자는 baseline 그대로다 — C2는 규칙 하나만 느는 변경이다.\n24\t */\n25\tpublic final class TicketReservationSteps {\n26\t\n27\t    private final UserStore userStore = new UserStore();\n28\t    private final TicketStore ticketStore = new TicketStore();\n29\t    private PaymentApi paymentApi = PaymentApi.succeeding();\n30\t\n31\t    private Boolean result;\n32\t    private Throwable thrown;\n33\t\n34\t    // --- Given ---\n35\t\n36\t    @Given(\"회원 저장소와 티켓 저장소가 비어 있다\")\n37\t    public void 저장소가_비어_있다() {\n38\t        this.result = null;\n39\t        this.thrown = null;\n40\t    }\n41\t\n42\t    @Given(\"회원 {long}이 등록되어 있다\")\n43\t    public void 회원이_등록되어_있다(long userId) {\n44\t        userStore.seed(new UserRecord(userId, \"user-\" + userId));\n45\t    }\n46\t\n47\t    @Given(\"가격 {int}원짜리 미예약 티켓 {long}이 있다\")\n48\t    public void 미예약_티켓이_있다(int price, long ticketId) {\n49\t        ticketStore.seed(new TicketRecord(ticketId, price));\n50\t    }\n51\t\n52\t    @Given(\"가격 {int}원짜리 이미 예약된 티켓 {long}이 있다\")\n53\t    public void 이미_예약된_티켓이_있다(int price, long ticketId) {\n54\t        TicketRecord reserved = new TicketRecord(ticketId, price);\n55\t        reserved.setReserved(true);\n56\t        reserved.setUserId(-1L);\n57\t        ticketStore.seed(reserved);\n58\t    }\n59\t\n60\t    @Given(\"회원 {long}이 이미 티켓 {long}을 예약해 두었다\")\n61\t    public void 이미_티켓을_예약해_두었다(long userId, long ticketId) {\n62\t        TicketRecord owned = new TicketRecord(ticketId, 30000);\n63\t        owned.setReserved(true);\n64\t        owned.setUserId(userId);\n65\t        ticketStore.seed(owned);\n66\t    }\n67\t\n68\t    @Given(\"결제는 거절되는 상황이다\")\n69\t    public void 결제는_거절된다() {\n70\t        this.paymentApi = PaymentApi.failing();\n71\t    }\n72\t\n73\t    // --- When ---\n74\t\n75\t    @When(\"회원 {long}이 카드정보 {string}으로 티켓 {long}을 예매하면\")\n76\t    public void 예매하면(long userId, String paymentInfo, long ticketId) {\n77\t        TicketService service = new TicketService(ticketStore, userStore, paymentApi);\n78\t        try {\n79\t            this.result = service.reserveTicket(userId, ticketId, paymentInfo);\n80\t        } catch (Throwable t) {\n81\t            this.thrown = t;\n82\t        }\n83\t    }\n84\t\n85\t    // --- Then ---\n86\t\n87\t    @Then(\"예매는 성공한다\")\n88\t    public void 예매는_성공한다() {\n89\t        assertThat(thrown).isNull();\n90\t        assertThat(result).isTrue();\n91\t    }\n92\t\n93\t    @Then(\"티켓 {long}은 회원 {long}에게 예약된다\")\n94\t    public void 티켓이_회원에게_예약된다(long ticketId, long userId) {\n95\t        TicketRecord stored = ticketStore.findById(ticketId);\n96\t        assertThat(stored.isReserved()).isTrue();\n97\t        assertThat(stored.getUserId()).isEqualTo(userId);\n98\t    }\n99\t\n100\t    @Then(\"{int}원이 청구된다\")\n101\t    public void 금액이_청구된다(int amount) {\n102\t        assertThat(paymentApi.wasCharged()).isTrue();\n103\t        assertThat(paymentApi.lastAmount()).isEqualTo(amount);\n104\t    }\n105\t\n106\t    @Then(\"예매는 회원 없음으로 거부된다\")\n107\t    public void 회원_없음으로_거부된다() {\n108\t        assertThat(thrown).isInstanceOf(UserNotFoundException.class);\n109\t    }\n110\t\n111\t    @Then(\"결제는 청구되지 않는다\")\n112\t    public void 결제는_청구되지_않는다() {\n113\t        assertThat(paymentApi.wasCharged()).isFalse();\n114\t    }\n115\t\n116\t    @Then(\"예매는 이미 예약됨으로 거부된다\")\n117\t    public void 이미_예약됨으로_거부된다() {\n118\t        assertThat(thrown).isInstanceOf(TicketAlreadyReservedException.class);\n119\t    }\n120\t\n121\t    @Then(\"예매는 1인 1매 제한으로 거부된다\")\n122\t    public void 제한으로_거부된다() {\n123\t        assertThat(thrown).isInstanceOf(TicketLimitExceededException.class);\n124\t    }\n125\t\n126\t    @Then(\"예매는 결제 실패로 거부된다\")\n127\t    public void 결제_실패로_거부된다() {\n128\t        assertThat(thrown).isInstanceOf(PaymentFailedException.class);\n129\t    }\n130\t\n131\t    @Then(\"티켓 {long}은 예약되지 않는다\")\n132\t    public void 티켓은_예약되지_않는다(long ticketId) {\n133\t        TicketRecord stored = ticketStore.findById(ticketId);\n134\t        assertThat(stored.isReserved()).isFalse();\n135\t    }\n136\t\n137\t    @Then(\"{int}원 청구가 시도된다\")\n138\t    public void 청구가_시도된다(int amount) {\n139\t        assertThat(paymentApi.wasCharged()).isTrue();\n140\t        assertThat(paymentApi.lastAmount()).isEqualTo(amount);\n141\t    }\n142\t}\n143\t"}]},"parent_tool_use_id":null,"session_id":"5c08bbf3-5d15-481f-8e6a-0ce0e8fe0246","uuid":"0e8e9766-f3ee-4f08-a368-dd1713013c91","timestamp":"2026-07-16T02:44:38.180Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\PC-220627-03\\Desktop\\project\\task\\ticket-kata-w2-r4\\src\\test\\java\\com\\thinking\\ticket\\steps\\TicketReservationSteps.java","content":"package com.thinking.ticket.steps;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.thinking.ticket.PaymentFailedException;\nimport com.thinking.ticket.TicketAlreadyReservedException;\nimport com.thinking.ticket.TicketLimitExceededException;\nimport com.thinking.ticket.TicketService;\nimport com.thinking.ticket.UserNotFoundException;\nimport com.thinking.ticket.provided.PaymentApi;\nimport com.thinking.ticket.provided.TicketRecord;\nimport com.thinking.ticket.provided.TicketStore;\nimport com.thinking.ticket.provided.UserRecord;\nimport com.thinking.ticket.provided.UserStore;\n\nimport io.cucumber.java.en.Given;\nimport io.cucumber.java.en.Then;\nimport io.cucumber.java.en.When;\n\n/**\n * 예매 유스케이스 경계의 인수테스트 step 정의. C2(1인 1매 제한) 시점.\n *\n * <p>진입점과 생성자는 baseline 그대로다 — C2는 규칙 하나만 느는 변경이다.\n */\npublic final class TicketReservationSteps {\n\n    private final UserStore userStore = new UserStore();\n    private final TicketStore ticketStore = new TicketStore();\n    private PaymentApi paymentApi = PaymentApi.succeeding();\n\n    private Boolean result;\n    private Throwable thrown;\n\n    // --- Given ---\n\n    @Given(\"회원 저장소와 티켓 저장소가 비어 있다\")\n    public void 저장소가_비어_있다() {\n        this.result = null;\n        this.thrown = null;\n    }\n\n    @Given(\"회원 {long}이 등록되어 있다\")\n    public void 회원이_등록되어_있다(long userId) {\n        userStore.seed(new UserRecord(userId, \"user-\" + userId));\n    }\n\n    @Given(\"가격 {int}원짜리 미예약 티켓 {long}이 있다\")\n    public void 미예약_티켓이_있다(int price, long ticketId) {\n        ticketStore.seed(new TicketRecord(ticketId, price));\n    }\n\n    @Given(\"가격 {int}원짜리 이미 예약된 티켓 {long}이 있다\")\n    public void 이미_예약된_티켓이_있다(int price, long ticketId) {\n        TicketRecord reserved = new TicketRecord(ticketId, price);\n        reserved.setReserved(true);\n        reserved.setUserId(-1L);\n        ticketStore.seed(reserved);\n    }\n\n    @Given(\"회원 {long}이 이미 티켓 {long}을 예약해 두었다\")\n    public void 이미_티켓을_예약해_두었다(long userId, long ticketId) {\n        TicketRecord owned = new TicketRecord(ticketId, 30000);\n        owned.setReserved(true);\n        owned.setUserId(userId);\n        ticketStore.seed(owned);\n    }\n\n    @Given(\"결제는 거절되는 상황이다\")\n    public void 결제는_거절된다() {\n        this.paymentApi = PaymentApi.failing();\n    }\n\n    // --- When ---\n\n    @When(\"회원 {long}이 카드정보 {string}으로 티켓 {long}을 예매하면\")\n    public void 예매하면(long userId, String paymentInfo, long ticketId) {\n        TicketService service = new TicketService(ticketStore, userStore, paymentApi);\n        try {\n            this.result = service.reserveTicket(userId, ticketId, paymentInfo);\n        } catch (Throwable t) {\n            this.thrown = t;\n        }\n    }\n\n    // --- Then ---\n\n    @Then(\"예매는 성공한다\")\n    public void 예매는_성공한다() {\n        assertThat(thrown).isNull();\n        assertThat(result).isTrue();\n    }\n\n    @Then(\"티켓 {long}은 회원 {long}에게 예약된다\")\n    public void 티켓이_회원에게_예약된다(long ticketId, long userId) {\n        TicketRecord stored = ticketStore.findById(ticketId);\n        assertThat(stored.isReserved()).isTrue();\n        assertThat(stored.getUserId()).isEqualTo(userId);\n    }\n\n    @Then(\"{int}원이 청구된다\")\n    public void 금액이_청구된다(int amount) {\n        assertThat(paymentApi.wasCharged()).isTrue();\n        assertThat(paymentApi.lastAmount()).isEqualTo(amount);\n    }\n\n    @Then(\"예매는 회원 없음으로 거부된다\")\n    public void 회원_없음으로_거부된다() {\n        assertThat(thrown).isInstanceOf(UserNotFoundException.class);\n    }\n\n    @Then(\"결제는 청구되지 않는다\")\n    public void 결제는_청구되지_않는다() {\n        assertThat(paymentApi.wasCharged()).isFalse();\n    }\n\n    @Then(\"예매는 이미 예약됨으로 거부된다\")\n    public void 이미_예약됨으로_거부된다() {\n        assertThat(thrown).isInstanceOf(TicketAlreadyReservedException.class);\n    }\n\n    @Then(\"예매는 1인 1매 제한으로 거부된다\")\n    public void 제한으로_거부된다() {\n        assertThat(thrown).isInstanceOf(TicketLimitExceededException.class);\n    }\n\n    @Then(\"예매는 결제 실패로 거부된다\")\n    public void 결제_실패로_거부된다() {\n        assertThat(thrown).isInstanceOf(PaymentFailedException.class);\n    }\n\n    @Then(\"티켓 {long}은 예약되지 않는다\")\n    public void 티켓은_예약되지_않는다(long ticketId) {\n        TicketRecord stored = ticketStore.findById(ticketId);\n        assertThat(stored.isReserved()).isFalse();\n    }\n\n    @Then(\"{int}원 청구가 시도된다\")\n    public void 청구가_시도된다(int amount) {\n        assertThat(paymentApi.wasCharged()).isTrue();\n        assertThat(paymentApi.lastAmount()).isEqualTo(amount);\n    }\n}\n","numLines":143,"startLine":1,"totalLines":143}}}
