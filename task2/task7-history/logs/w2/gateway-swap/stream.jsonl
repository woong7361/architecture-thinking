{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wq7skR9sUnqtoFNcWSXZLo","type":"tool_result","content":"1\tpackage com.thinking.ticket.steps;\n2\t\n3\timport static org.assertj.core.api.Assertions.assertThat;\n4\t\n5\timport com.thinking.ticket.PaymentFailedException;\n6\timport com.thinking.ticket.TicketAlreadyReservedException;\n7\timport com.thinking.ticket.TicketService;\n8\timport com.thinking.ticket.UserNotFoundException;\n9\timport com.thinking.ticket.provided.PaymentGateway;\n10\timport com.thinking.ticket.provided.TicketRecord;\n11\timport com.thinking.ticket.provided.TicketStore;\n12\timport com.thinking.ticket.provided.UserRecord;\n13\timport com.thinking.ticket.provided.UserStore;\n14\t\n15\timport io.cucumber.java.en.Given;\n16\timport io.cucumber.java.en.Then;\n17\timport io.cucumber.java.en.When;\n18\t\n19\t/**\n20\t * 예매 유스케이스 경계의 인수테스트 step 정의. 결제사 교체 시점.\n21\t *\n22\t * <p>feature 파일의 시나리오는 한 줄도 바뀌지 않았다 — 결제사가 바뀌어도 예매의 관찰 가능한 동작은\n23\t * 같아야 하기 때문이다. 바뀐 것은 이 파일이 어느 결제사 시뮬레이터에 물리는가뿐이다.\n24\t */\n25\tpublic final class TicketReservationSteps {\n26\t\n27\t    private final UserStore userStore = new UserStore();\n28\t    private final TicketStore ticketStore = new TicketStore();\n29\t    private PaymentGateway gateway = PaymentGateway.approving();\n30\t\n31\t    private Boolean result;\n32\t    private Throwable thrown;\n33\t\n34\t    // --- Given ---\n35\t\n36\t    @Given(\"회원 저장소와 티켓 저장소가 비어 있다\")\n37\t    public void 저장소가_비어_있다() {\n38\t        this.result = null;\n39\t        this.thrown = null;\n40\t    }\n41\t\n42\t    @Given(\"회원 {long}이 등록되어 있다\")\n43\t    public void 회원이_등록되어_있다(long userId) {\n44\t        userStore.seed(new UserRecord(userId, \"user-\" + userId));\n45\t    }\n46\t\n47\t    @Given(\"가격 {int}원짜리 미예약 티켓 {long}이 있다\")\n48\t    public void 미예약_티켓이_있다(int price, long ticketId) {\n49\t        ticketStore.seed(new TicketRecord(ticketId, price));\n50\t    }\n51\t\n52\t    @Given(\"가격 {int}원짜리 이미 예약된 티켓 {long}이 있다\")\n53\t    public void 이미_예약된_티켓이_있다(int price, long ticketId) {\n54\t        TicketRecord reserved = new TicketRecord(ticketId, price);\n55\t        reserved.setReserved(true);\n56\t        reserved.setUserId(-1L);\n57\t        ticketStore.seed(reserved);\n58\t    }\n59\t\n60\t    @Given(\"결제는 거절되는 상황이다\")\n61\t    public void 결제는_거절된다() {\n62\t        this.gateway = PaymentGateway.declining();\n63\t    }\n64\t\n65\t    // --- When ---\n66\t\n67\t    @When(\"회원 {long}이 카드정보 {string}으로 티켓 {long}을 예매하면\")\n68\t    public void 예매하면(long userId, String paymentInfo, long ticketId) {\n69\t        TicketService service = new TicketService(ticketStore, userStore, gateway);\n70\t        try {\n71\t            this.result = service.reserveTicket(userId, ticketId, paymentInfo);\n72\t        } catch (Throwable t) {\n73\t            this.thrown = t;\n74\t        }\n75\t    }\n76\t\n77\t    // --- Then ---\n78\t\n79\t    @Then(\"예매는 성공한다\")\n80\t    public void 예매는_성공한다() {\n81\t        assertThat(thrown).isNull();\n82\t        assertThat(result).isTrue();\n83\t    }\n84\t\n85\t    @Then(\"티켓 {long}은 회원 {long}에게 예약된다\")\n86\t    public void 티켓이_회원에게_예약된다(long ticketId, long userId) {\n87\t        TicketRecord stored = ticketStore.findById(ticketId);\n88\t        assertThat(stored.isReserved()).isTrue();\n89\t        assertThat(stored.getUserId()).isEqualTo(userId);\n90\t    }\n91\t\n92\t    @Then(\"{int}원이 청구된다\")\n93\t    public void 금액이_청구된다(int amount) {\n94\t        assertThat(gateway.wasAuthorized()).isTrue();\n95\t        assertThat(gateway.lastAmount()).isEqualTo(amount);\n96\t    }\n97\t\n98\t    @Then(\"예매는 회원 없음으로 거부된다\")\n99\t    public void 회원_없음으로_거부된다() {\n100\t        assertThat(thrown).isInstanceOf(UserNotFoundException.class);\n101\t    }\n102\t\n103\t    @Then(\"결제는 청구되지 않는다\")\n104\t    public void 결제는_청구되지_않는다() {\n105\t        assertThat(gateway.wasAuthorized()).isFalse();\n106\t    }\n107\t\n108\t    @Then(\"예매는 이미 예약됨으로 거부된다\")\n109\t    public void 이미_예약됨으로_거부된다() {\n110\t        assertThat(thrown).isInstanceOf(TicketAlreadyReservedException.class);\n111\t    }\n112\t\n113\t    @Then(\"예매는 결제 실패로 거부된다\")\n114\t    public void 결제_실패로_거부된다() {\n115\t        assertThat(thrown).isInstanceOf(PaymentFailedException.class);\n116\t    }\n117\t\n118\t    @Then(\"티켓 {long}은 예약되지 않는다\")\n119\t    public void 티켓은_예약되지_않는다(long ticketId) {\n120\t        TicketRecord stored = ticketStore.findById(ticketId);\n121\t        assertThat(stored.isReserved()).isFalse();\n122\t    }\n123\t\n124\t    @Then(\"{int}원 청구가 시도된다\")\n125\t    public void 청구가_시도된다(int amount) {\n126\t        assertThat(gateway.wasAuthorized()).isTrue();\n127\t        assertThat(gateway.lastAmount()).isEqualTo(amount);\n128\t    }\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"94526d24-512f-4020-89b1-f329fd35365f","uuid":"e6033a6c-edd4-47f6-8f8a-8da065848d8a","timestamp":"2026-07-16T02:26:13.639Z","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/PC-220627-03/Desktop/project/task/ticket-kata-w2/src/test/java/com/thinking/ticket/steps/TicketReservationSteps.java","content":"package com.thinking.ticket.steps;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\nimport com.thinking.ticket.PaymentFailedException;\nimport com.thinking.ticket.TicketAlreadyReservedException;\nimport com.thinking.ticket.TicketService;\nimport com.thinking.ticket.UserNotFoundException;\nimport com.thinking.ticket.provided.PaymentGateway;\nimport com.thinking.ticket.provided.TicketRecord;\nimport com.thinking.ticket.provided.TicketStore;\nimport com.thinking.ticket.provided.UserRecord;\nimport com.thinking.ticket.provided.UserStore;\n\nimport io.cucumber.java.en.Given;\nimport io.cucumber.java.en.Then;\nimport io.cucumber.java.en.When;\n\n/**\n * 예매 유스케이스 경계의 인수테스트 step 정의. 결제사 교체 시점.\n *\n * <p>feature 파일의 시나리오는 한 줄도 바뀌지 않았다 — 결제사가 바뀌어도 예매의 관찰 가능한 동작은\n * 같아야 하기 때문이다. 바뀐 것은 이 파일이 어느 결제사 시뮬레이터에 물리는가뿐이다.\n */\npublic final class TicketReservationSteps {\n\n    private final UserStore userStore = new UserStore();\n    private final TicketStore ticketStore = new TicketStore();\n    private PaymentGateway gateway = PaymentGateway.approving();\n\n    private Boolean result;\n    private Throwable thrown;\n\n    // --- Given ---\n\n    @Given(\"회원 저장소와 티켓 저장소가 비어 있다\")\n    public void 저장소가_비어_있다() {\n        this.result = null;\n        this.thrown = null;\n    }\n\n    @Given(\"회원 {long}이 등록되어 있다\")\n    public void 회원이_등록되어_있다(long userId) {\n        userStore.seed(new UserRecord(userId, \"user-\" + userId));\n    }\n\n    @Given(\"가격 {int}원짜리 미예약 티켓 {long}이 있다\")\n    public void 미예약_티켓이_있다(int price, long ticketId) {\n        ticketStore.seed(new TicketRecord(ticketId, price));\n    }\n\n    @Given(\"가격 {int}원짜리 이미 예약된 티켓 {long}이 있다\")\n    public void 이미_예약된_티켓이_있다(int price, long ticketId) {\n        TicketRecord reserved = new TicketRecord(ticketId, price);\n        reserved.setReserved(true);\n        reserved.setUserId(-1L);\n        ticketStore.seed(reserved);\n    }\n\n    @Given(\"결제는 거절되는 상황이다\")\n    public void 결제는_거절된다() {\n        this.gateway = PaymentGateway.declining();\n    }\n\n    // --- When ---\n\n    @When(\"회원 {long}이 카드정보 {string}으로 티켓 {long}을 예매하면\")\n    public void 예매하면(long userId, String paymentInfo, long ticketId) {\n        TicketService service = new TicketService(ticketStore, userStore, gateway);\n        try {\n            this.result = service.reserveTicket(userId, ticketId, paymentInfo);\n        } catch (Throwable t) {\n            this.thrown = t;\n        }\n    }\n\n    // --- Then ---\n\n    @Then(\"예매는 성공한다\")\n    public void 예매는_성공한다() {\n        assertThat(thrown).isNull();\n        assertThat(result).isTrue();\n    }\n\n    @Then(\"티켓 {long}은 회원 {long}에게 예약된다\")\n    public void 티켓이_회원에게_예약된다(long ticketId, long userId) {\n        TicketRecord stored = ticketStore.findById(ticketId);\n        assertThat(stored.isReserved()).isTrue();\n        assertThat(stored.getUserId()).isEqualTo(userId);\n    }\n\n    @Then(\"{int}원이 청구된다\")\n    public void 금액이_청구된다(int amount) {\n        assertThat(gateway.wasAuthorized()).isTrue();\n        assertThat(gateway.lastAmount()).isEqualTo(amount);\n    }\n\n    @Then(\"예매는 회원 없음으로 거부된다\")\n    public void 회원_없음으로_거부된다() {\n        assertThat(thrown).isInstanceOf(UserNotFoundException.class);\n    }\n\n    @Then(\"결제는 청구되지 않는다\")\n    public void 결제는_청구되지_않는다() {\n        assertThat(gateway.wasAuthorized()).isFalse();\n    }\n\n    @Then(\"예매는 이미 예약됨으로 거부된다\")\n    public void 이미_예약됨으로_거부된다() {\n        assertThat(thrown).isInstanceOf(TicketAlreadyReservedException.class);\n    }\n\n    @Then(\"예매는 결제 실패로 거부된다\")\n    public void 결제_실패로_거부된다() {\n        assertThat(thrown).isInstanceOf(PaymentFailedException.class);\n    }\n\n    @Then(\"티켓 {long}은 예약되지 않는다\")\n    public void 티켓은_예약되지_않는다(long ticketId) {\n        TicketRecord stored = ticketStore.findById(ticketId);\n        assertThat(stored.isReserved()).isFalse();\n    }\n\n    @Then(\"{int}원 청구가 시도된다\")\n    public void 청구가_시도된다(int amount) {\n        assertThat(gateway.wasAuthorized()).isTrue();\n        assertThat(gateway.lastAmount()).isEqualTo(amount);\n    }\n}\n","numLines":130,"startLine":1,"totalLines":130}}}
