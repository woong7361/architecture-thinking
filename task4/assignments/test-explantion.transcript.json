    {
      "start_seconds": 59.95,
      "end_seconds": 64.95,
      "text": "그 결과들은 항상 달라집니다."
    },
    {
      "start_seconds": 64.95,
      "end_seconds": 66.45,
      "text": "항상 흔들리게 되죠."
    },
    {
      "start_seconds": 66.45,
      "end_seconds": 70.65,
      "text": "그렇다면 판정 테스트 코드가 있다면 그것은 괜찮은 건가요?"
    },
    {
      "start_seconds": 70.65,
      "end_seconds": 75.05,
      "text": "테스트 코드가 있다는 것은 그 코드가 안전하다는 건가요?"
    },
    {
      "start_seconds": 75.05,
      "end_seconds": 78.35,
      "text": "그거는 맞을 수도 있고 아닐 수도 있습니다."
    },
    {
      "start_seconds": 78.35,
      "end_seconds": 80.25,
      "text": "테스트의 초록 빨강은"
