    {
      "start_seconds": 246.4,
      "end_seconds": 248.9,
      "text": "되게 중요합니다."
    },
    {
      "start_seconds": 248.9,
      "end_seconds": 251.6,
      "text": "위처럼 이제 계속 바뀌지 않고"
    },
    {
      "start_seconds": 251.6,
      "end_seconds": 254.3,
      "text": "이것이 내가 딱 이걸 봤을 때"
    },
    {
      "start_seconds": 254.3,
      "end_seconds": 256.2,
      "text": "아 이거는 그래도 이거에 대해서는"
    },
    {
      "start_seconds": 256.2,
      "end_seconds": 258.1,
      "text": "되게 정확히 동작한다"
    },
    {
      "start_seconds": 258.1,
      "end_seconds": 260.2,
      "text": "동작을 보장한다"
    },
    {
      "start_seconds": 260.2,
      "end_seconds": 261.4,
      "text": "하지만 아까 말했듯이"
    },
    {
      "start_seconds": 261.4,
      "end_seconds": 263.7,
      "text": "그것이 항상 안전하다는 것은"
    },
    {
      "start_seconds": 263.7,
      "end_seconds": 267.0,
      "text": "그것을 보장한다는 것은 아닙니다."
    },
    {
      "start_seconds": 267.0,
      "end_seconds": 270.2,
      "text": "그래서 테스트 코드가 그냥 단순히 있는 게 아니라"
    },
    {
      "start_seconds": 270.2,
      "end_seconds": 271.8,
      "text": "가장 중요한 것은"
    },
    {
      "start_seconds": 271.8,
      "end_seconds": 274.5,
      "text": "이것을 통과하는 입력이 어떤 것인지"
    },
    {
      "start_seconds": 274.5,
      "end_seconds": 277.1,
      "text": "이것이 정말 어떤 것을 보장하는 것인지"
    },
    {
      "start_seconds": 277.1,
      "end_seconds": 280.8,
      "text": "이 테스트가 그냥 잘못된 것은 아닌지"
    },
    {
      "start_seconds": 280.8,
      "end_seconds": 283.5,
      "text": "그런 것이 더 중요하다고 생각합니다."
    },
    {
      "start_seconds": 283.5,
      "end_seconds": 285.1,
      "text": "그렇기 때문에"
    },
    {
      "start_seconds": 285.1,
      "end_seconds": 288.7,
      "text": "여기서 당신이 한번 해볼 수 있는 것은"
    },
    {
      "start_seconds": 288.7,
      "end_seconds": 290.2,
      "text": "테스트 코드가 있다면"
    },
    {
      "start_seconds": 290.2,
      "end_seconds": 292.0,
      "text": "초록인 테스트 코드를 하나를 골라서"
    },
    {
      "start_seconds": 292.0,
      "end_seconds": 293.8,
      "text": "부동 하나를 씹어보는 겁니다."
    },
    {
      "start_seconds": 293.8,
      "end_seconds": 296.2,
      "text": "혹은 입력을 바꿔보던가"
    },
    {
      "start_seconds": 296.2,
      "end_seconds": 299.4,
      "text": "코드를 조금 바꿔보는 겁니다."
    },
    {
      "start_seconds": 299.4,
      "end_seconds": 302.8,
      "text": "그렇다면 그 코드가 계속 초록이라면"
    },
    {
      "start_seconds": 302.8,
      "end_seconds": 304.6,
      "text": "당신은 있고"
    },
    {
      "start_seconds": 304.6,
      "end_seconds": 306.9,
      "text": "정말 쓸모없는 테스트 코드를"
    },
    {
      "start_seconds": 306.9,
      "end_seconds": 309.1,
      "text": "하나 버려낼 수 있고"
    },
    {
      "start_seconds": 309.1,
      "end_seconds": 312.2,
      "text": "그 테스트가 빨강으로 된다면"
    },
    {
      "start_seconds": 312.2,
      "end_seconds": 314.3,
      "text": "이 테스트가 정말"
    },
    {
      "start_seconds": 314.3,
      "end_seconds": 315.9,
      "text": "어떤 걸 검색하고 있거나"
    },
    {
      "start_seconds": 315.9,
      "end_seconds": 317.4,
      "text": "중요한 걸 검증하고 있구나"
    },
    {
      "start_seconds": 317.4,
      "end_seconds": 319.4,
      "text": "라는 것을 알 수 있습니다."
    },
    {
      "start_seconds": 319.4,
      "end_seconds": 320.3,
      "text": "1분을 또 자여"
    },
    {
      "start_seconds": 320.3,
      "end_seconds": 324.73,
      "text": "단순히 진정한 게이트를 얻을 수 있는 것입니다."
    },
    {
      "start_seconds": 324.73,
      "end_seconds": 325.53,
      "text": "감사합니다."
    }
