{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keyword Extraction",
  "type": "object",
  "required": ["brief_hash", "batch_no", "stage", "postings"],
  "properties": {
    "brief_hash": {
      "type": "string",
      "description": "입력부터 최종 산출물까지 공유하는 brief hash"
    },
    "batch_no": {
      "type": "string",
      "description": "Keyword extraction batch 번호"
    },
    "stage": {
      "type": "string",
      "enum": ["keyword_extract"]
    },
    "postings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/posting"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "posting": {
      "type": "object",
      "required": [
        "posting_id",
        "company_name",
        "company_size",
        "domain",
        "role_title",
        "reference_link",
        "items",
        "warnings"
      ],
      "properties": {
        "posting_id": {
          "type": "string"
        },
        "company_name": {
          "type": "string"
        },
        "company_size": {
          "type": "string",
          "description": "입력에서 받은 회사 규모 값을 그대로 사용한다. 모르면 unknown을 사용한다."
        },
        "domain": {
          "type": "string",
          "description": "입력에서 받은 도메인 값을 그대로 사용한다. 모르면 unknown을 사용한다."
        },
        "role_title": {
          "type": "string"
        },
        "reference_link": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["item_id", "item_type", "section", "source_spans", "terms"],
      "properties": {
        "item_id": {
          "type": "string",
          "description": "예: p001-k001"
        },
        "item_type": {
          "type": "string",
          "enum": [
            "technical_stack",
            "required_experience",
            "responsibility",
            "collaboration",
            "product_context",
            "domain_context",
            "culture",
            "process",
            "seniority",
            "benefit",
            "other"
          ]
        },
        "section": {
          "type": "string",
          "enum": [
            "required_qualifications",
            "preferred_qualifications",
            "responsibilities",
            "tech_stack",
            "culture",
            "benefits",
            "company_intro",
            "hiring_process",
            "unknown"
          ]
        },
        "source_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_span"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "source_span": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
