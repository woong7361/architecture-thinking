{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recruiting Harness Input",
  "type": "object",
  "required": ["brief_hash", "created_at", "analysis_goal", "batch_size", "postings"],
  "properties": {
    "brief_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,}$",
      "description": "한 분석 run을 관통하는 유일 식별자"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "입력 파일이 생성된 시각"
    },
    "analysis_goal": {
      "type": "string",
      "minLength": 1
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Keyword Extract stage에서 한 번에 처리할 공고 수"
    },
    "postings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/posting"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "posting": {
      "type": "object",
      "required": [
        "posting_id",
        "company_name",
        "company_size",
        "domain",
        "role_title",
        "reference_link",
        "raw_text"
      ],
      "properties": {
        "posting_id": {
          "type": "string",
          "minLength": 1
        },
        "company_name": {
          "type": "string",
          "minLength": 1
        },
        "company_size": {
          "type": "string",
          "enum": ["startup", "scaleup", "mid_size", "enterprise", "unknown"]
        },
        "domain": {
          "type": "string",
          "enum": [
            "education",
            "healthcare",
            "finance",
            "commerce",
            "saas",
            "game",
            "ai",
            "content",
            "public_sector",
            "manufacturing",
            "mobility",
            "unknown"
          ]
        },
        "domain_note": {
          "type": "string"
        },
        "role_title": {
          "type": "string",
          "minLength": 1
        },
        "reference_link": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
