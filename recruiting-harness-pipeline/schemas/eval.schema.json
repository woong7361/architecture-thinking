{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis Score Evaluation",
  "type": "object",
  "required": ["brief_hash", "stage", "rubric_name", "axis_scores", "summary"],
  "properties": {
    "brief_hash": {
      "type": "string",
      "description": "입력부터 최종 산출물까지 공유하는 brief hash"
    },
    "stage": {
      "type": "string",
      "enum": ["evaluate"]
    },
    "rubric_name": {
      "type": "string"
    },
    "axis_scores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/axis_score"
      }
    },
    "summary": {
      "type": "string",
      "description": "점수 판단의 전체 요약"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "axis_score": {
      "type": "object",
      "required": ["axis", "score", "rationale"],
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "evidence_linkage",
            "inference_discipline",
            "pattern_quality",
            "alternative_reading",
            "distribution_awareness"
          ]
        },
        "score": {
          "type": "number",
          "description": "rubric 기준에 따른 0~5 점수"
        },
        "rationale": {
          "type": "string",
          "description": "JSON 필드에서 확인 가능한 근거 중심 점수 이유"
        }
      },
      "additionalProperties": false
    }
  }
}
